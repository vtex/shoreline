{
  "$schema": "https://turborepo.org/schema.json",
  "globalDependencies": ["tools/design-system/theme-registry.cjs"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "outputs": ["dist/**"],
      "dependsOn": ["^dev"]
    }
  }
}
